# dont use 80 or 443 as caddy will strip them from redirects
http://localhost:8080, https://localhost:8443 {
    header {
        # Allow any origin to make requests
        Access-Control-Allow-Origin *
        
        # Allow all common HTTP methods
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        
        # Allow all common headers (including custom ones)
        Access-Control-Allow-Headers "*"

        # Allow requests from public sites to this private network address
        Access-Control-Allow-Private-Network true

        Vary "Origin"
    }

    # Immediately respond to preflight OPTIONS requests with a 204
    @cors_preflight {
        method OPTIONS
    }
    respond @cors_preflight 204

    reverse_proxy app:8111 {
        # Remove duplicate CORS headers generated by the upstream app
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Methods
        header_down -Access-Control-Allow-Headers
        header_down -Access-Control-Allow-Private-Network
    }
}
